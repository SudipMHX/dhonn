# Required: MongoDB Atlas connection string or local MongoDB URI.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority

# Required: generate with `npx auth secret` (or a cryptographically random 32+ byte secret).
AUTH_SECRET=
# Required when deployed behind a trusted host/proxy.
AUTH_TRUST_HOST=true
# Public application origin used for canonical metadata and generated URLs.
APP_URL=http://localhost:3000

# Required for audio uploads and playback. Cloudflare R2 uses region `auto`.
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional CDN/custom domain for future public delivery; playback currently uses short-lived signed GET URLs.
AUDIO_PUBLIC_BASE_URL=

# Optional initial administrator. Set both values, run `npm run seed`, then remove the password from the environment.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# Optional contact address shown on the Contact page.
CONTACT_EMAIL=
